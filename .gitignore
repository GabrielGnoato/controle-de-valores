@'
# Bancos de dados
*.db
*.sqlite
*.sqlite3

# Relatórios financeiros
meses/*
!meses/.gitkeep

# Ferramentas SQLite
sqlite3.exe
sqldiff.exe
sqlite3_analyzer.exe
sqlite3_rsync.exe

# Executáveis
*.exe

# Python temporário
__pycache__/
*.py[cod]

# Compilação
build/
dist/

# Ambientes virtuais
venv/
.venv/

# Logs
*.log
'@ | Set-Content -Encoding UTF8 .gitignore
